{
  "name": "family-tree-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "teru1337",
  "description": "Локальное Windows-приложение для создания, хранения и визуализации семейного дерева.",
  "repository": {
    "type": "git",
    "url": "https://github.com/teru1337/family-tree-desktop.git"
  },
  "homepage": "https://github.com/teru1337/family-tree-desktop/releases",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build && node scripts/prepare-sites-build.mjs",
    "build": "npm run build:renderer",
    "start": "electron .",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:stage7": "node --test tests/stage-7-data.test.mjs",
    "test:packaging": "node --test tests/windows-packaging.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron-updater": "6.8.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.teru1337.familytree",
    "productName": "Семейное древо",
    "artifactName": "FamilyTree-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Семейное древо",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "teru1337",
      "repo": "family-tree-desktop",
      "releaseType": "release"
    }
  }
}
